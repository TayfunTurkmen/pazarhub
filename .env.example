AUTH_SECRET=change-me-with-openssl-rand-hex-32
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/skonutal
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Coolify: linked Postgres sets DATABASE_URL. Skip embedded Postgres automatically.
# SKIP_EMBEDDED_POSTGRES=1
# SEED_ON_START=0
# PORT=3000
# HOSTNAME=0.0.0.0

# PayTR (boşsa DEMO ödeme kullanılır)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# iyzico (boşsa DEMO ödeme kullanılır)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_SANDBOX=1
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Evolution API (aynı container, 127.0.0.1:8080)
# EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=skonutal-evolution-key
AUTHENTICATION_API_KEY=skonutal-evolution-key
EVOLUTION_INSTANCE=skonutal
