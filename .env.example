# ── Required in production ──
AUTH_SECRET=
NEXTAUTH_SECRET=

# Supabase (Vercel Marketplace: vercel integration add supabase)
# Runtime — pooled connection (port 6543 / pgbouncer)
DATABASE_URL=
# Migrations — direct connection (port 5432)
DIRECT_URL=

# Auto-provisioned by Supabase integration (optional, for future SDK use)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel URLs (production domaininize göre güncelleyin) ──
AUTH_URL=https://sahibindenkonutal.vercel.app
NEXTAUTH_URL=https://sahibindenkonutal.vercel.app
NEXT_PUBLIC_APP_URL=https://sahibindenkonutal.vercel.app
NEXT_PUBLIC_APP_NAME=SahibindenKonutal

# ── Recommended in production ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# ── AI (Optional — fallback heuristics when unset) ──
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Optional ──
# DISABLE_RATE_LIMIT=true  # development only
# NODE_ENV=development

# ── OAuth (Google / Facebook) ──
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
