{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "buildAptPackages": ["openssl", "python3", "ffmpeg"],
  "steps": {
    "install": {
      "commands": ["npm ci --include=dev"]
    },
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "aptPackages": ["openssl", "ffmpeg", "python3"],
    "startCommand": "bash docker/entrypoint.sh",
    "variables": {
      "SKIP_EVOLUTION": "1"
    }
  }
}
